---
import Reveal from './Reveal.astro';
---

<section class="section" id="register" aria-labelledby="register-title">
  <div class="wrap">
    <Reveal>
      <h2 class="display" id="register-title">Enter your team.</h2>
    </Reveal>
    <Reveal delay={80}>
      <div>
        <a class="slab slab-solid" href="#register">
          <span>Register — to confirm</span><span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="slab-caption">Tell us where teams sign up and this slab points there.</p>
      </div>
    </Reveal>
  </div>
</section>
