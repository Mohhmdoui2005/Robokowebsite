---
import Reveal from './Reveal.astro';
---

<section class="section" id="rules" aria-labelledby="rules-title">
  <div class="wrap">
    <Reveal>
      <h2 class="display" id="rules-title">Ring law.</h2>
    </Reveal>
    <Reveal delay={80}>
      <ul class="rules-list">
        <li>
          <span class="mark" aria-hidden="true">一</span>
          <div>Push out. Do not destroy.<p>Machines that damage the ring or the opponent leave the competition.</p></div>
        </li>
        <li>
          <span class="mark" aria-hidden="true">二</span>
          <div>Autonomy is earned.<p>Control rules for each class are written in the specification book.</p></div>
        </li>
        <li>
          <span class="mark" aria-hidden="true">三</span>
          <div>The referee’s call stands.<p>Disputes are settled at the ring, in the minute, with the book open.</p></div>
        </li>
      </ul>
    </Reveal>
  </div>
</section>
